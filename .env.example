# ==========================================
# Price Tracker Platform - Variables de Entorno
# ==========================================
# Copia este archivo como .env para desarrollo local:
# cp .env.example .env

# --- Base de datos (PostgreSQL local) ---
POSTGRES_DB=price_tracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/price_tracker

# --- Backend API (FastAPI) ---
API_PORT=8000
API_HOST=0.0.0.0
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
INTERNAL_API_KEY=dev-internal-secret-token

# --- Worker de Scraping ---
WORKER_POLL_INTERVAL=5
REQUEST_TIMEOUT_SECONDS=15
SCRAPER_USER_AGENT=PriceTrackerBot/1.0 (+https://github.com/price-tracker-platform)

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
